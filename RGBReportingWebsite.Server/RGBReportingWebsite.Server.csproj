<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifier>win-x64</ContainerRuntimeIdentifier>

    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-nanoserver-ltsc2022</ContainerBaseImage>

    <UserSecretsId>2bc09420-3b97-44e6-9697-0468fcff91c4</UserSecretsId>

    <DockerfileContext>..\RGBReportingWebsite</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for Blazor WebAssembly hosted server helpers (UseBlazorFrameworkFiles) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="TMS.FlexCel" Version="7.25.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RGBReportingWebsite.Client\RGBReportingWebsite.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

</Project>