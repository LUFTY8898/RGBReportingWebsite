@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">

            <div class="top-message">
                Hello and welcome to the RGB Reporting Website.
            </div>

            <AuthorizeView>
                <Authorized>
                    Hello, @context.User.Identity?.Name
                </Authorized>
                <NotAuthorized>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
